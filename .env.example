# Get this from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Comma-separated list of Telegram numeric user IDs who are allowed to act as escrow admins.
# Get your own numeric ID by messaging @userinfobot on Telegram.
ADMIN_IDS=2096985880

# Where the SQLite DB file lives. On Render, point this at your mounted disk.
DB_PATH=./data/escrow.db

# The group chat where "payment not received" notices get posted.
# Get this by forwarding any message from that group to @userinfobot.
GROUP_CHAT_ID=-1003158424354
